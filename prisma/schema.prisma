generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model QuizType {
  id               Int      @id @default(autoincrement())
  slug             String   @unique @db.VarChar(191)
  title            String   @db.VarChar(200)
  subtitle         String?  @db.VarChar(300)
  description      String   @db.Text
  category         String   @db.VarChar(100)
  categoryColor    String   @default("#0f7c85") @db.VarChar(20)
  imageUrl         String?  @db.VarChar(500)
  icon             String?  @db.VarChar(10)
  estimatedMinutes Int      @default(5)
  difficulty       String   @default("Beginner") @db.VarChar(50)
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  canonicalUrl     String?  @db.VarChar(255)
  jsonLd           Json?
  ogImage          String?  @db.VarChar(255)
  seoDescription   String?  @db.Text
  seoTitle         String?  @db.VarChar(255)
  siteId           String?  @db.VarChar(100)

  @@index([siteId], map: "QuizType_siteId_idx")
  @@index([siteId, isActive, sortOrder], map: "QuizType_siteId_isActive_sortOrder_idx")
  @@map("quiz_types")
}

model Quiz {
  id            Int     @id @default(autoincrement()) @map("_id")
  category      String? @default("general-wellness") @db.VarChar(100)
  question      String  @db.Text
  options       String  @db.Text
  correctAnswer String  @db.Text
  explanation   String  @db.Text

  @@index([category], map: "Quiz_category_idx")
  @@map("quizzes")
}

model IpQuizAnalytic {
  id      Int    @id @default(autoincrement())
  user_ip String @db.VarChar(45)
  played  Int    @default(0)

  @@index([user_ip], map: "IpQuizAnalytic_user_ip_idx")
  @@map("ip_quiz_analytic")
}

model QuizAnalytics {
  id            Int    @id @default(autoincrement())
  userId        String @db.VarChar(100)
  quizId        Int
  correct       Int
  choose_option String @db.VarChar(100)
  time_taken    String @db.VarChar(50)

  @@index([userId], map: "QuizAnalytics_userId_idx")
  @@index([quizId], map: "QuizAnalytics_quizId_idx")
  @@index([userId, quizId], map: "QuizAnalytics_userId_quizId_idx")
  @@map("quiz_analytics")
}

model Magazine {
  id               Int       @id @default(autoincrement()) @map("idMagazines")
  magazineId       String    @map("magazine_id") @db.VarChar(191)
  title            String    @map("magazine_title") @db.VarChar(255)
  description      String    @map("magazine_description") @db.Text
  introduction     String?   @map("magazine_introduction") @db.Text
  backImage        String?   @map("magazine_back_image") @db.VarChar(255)
  spineImage       String?   @map("magazine_spine_image") @db.VarChar(255)
  tags             String    @map("magazine_tags") @db.VarChar(255)
  coverImage       String    @map("magazine_cover_image") @db.VarChar(255)
  link             String    @map("magazine_link") @db.VarChar(255)
  date             DateTime  @map("magazine_date") @db.Date
  category         String    @map("magazine_category") @db.VarChar(255)
  magCloudLink     String    @map("MagCloudLink") @db.VarChar(255)
  slug             String    @unique @map("magazine_slug") @db.VarChar(191)
  status           Int       @default(1)
  timestamp        DateTime  @default(now()) @map("magazine_timestamp")
  publisherSocials Json?     @map("publisher_socials")
  insideIssue      Json?     @map("inside_issue")
  canonicalUrl     String?   @map("canonical_url") @db.VarChar(255)
  jsonLd           Json?     @map("json_ld")
  ogImage          String?   @map("og_image") @db.VarChar(255)
  seoDescription   String?   @map("seo_description") @db.Text
  seoTitle         String?   @map("seo_title") @db.VarChar(255)
  siteId           String?   @map("site_id") @db.VarChar(100)
  comments         comment[]

  @@index([siteId, status, date], map: "Magazine_siteId_status_date_idx")
  @@index([status, date], map: "Magazine_status_date_idx")
  @@index([magazineId], map: "Magazine_magazineId_idx")
  @@index([date], map: "Magazine_date_idx")
  @@map("magazines")
}

model Auth {
  id           Int       @id @default(autoincrement()) @map("idauth")
  name         String?   @db.VarChar(255)
  username     String?   @unique @db.VarChar(191)
  email        String?   @unique @db.VarChar(191)
  password     String?   @db.VarChar(255)
  role         String?   @default("user") @db.VarChar(50)
  profile      String?   @db.VarChar(255)
  profession   String?   @db.VarChar(255)
  bio          String?   @db.Text
  date         DateTime  @default(now())
  otp          String?   @db.VarChar(50)
  otpCreatedAt DateTime?

  @@index([role], map: "Auth_role_idx")
  @@index([date], map: "Auth_date_idx")
  @@map("auth")
}

model LegacyAd {
  id             Int       @id @default(autoincrement())
  title          String    @db.VarChar(255)
  description    String?   @db.Text
  mediaUrl       String    @map("media_url") @db.Text
  mediaType      String    @default("image") @map("media_type") @db.VarChar(20)
  targetUrl      String    @map("target_url") @db.Text
  placement      String
  status         String    @default("draft") @db.VarChar(20)
  priority       Int       @default(1)
  startDate      DateTime? @map("start_date")
  endDate        DateTime? @map("end_date")
  targetDevice   String?   @map("target_device") @db.VarChar(20)
  targetLocation String?   @map("target_location")
  createdBy      Int?      @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([placement, status])
  @@map("ads")
}

model LegacyAdEvent {
  id        Int      @id @default(autoincrement())
  adId      Int      @map("ad_id")
  eventType String   @map("event_type") @db.VarChar(10)
  userIp    String?  @map("user_ip") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([adId, eventType])
  @@index([createdAt], map: "LegacyAdEvent_createdAt_idx")
  @@map("ad_events")
}

model CommunityEvent {
  id            String   @id @default(cuid()) @db.VarChar(50)
  siteId        String   @db.VarChar(100)
  title         String   @db.VarChar(255)
  category      String   @default("MINDFULNESS WALK")
  description   String   @db.Text
  imageUrl      String?
  eventDate     String?  @default("Sat, 27 July 2024")
  eventTime     String?  @default("9:00 AM – 11:30 AM")
  location      String?  @default("City Nature Park")
  tags          String?  @default("Mindfulness, Outdoor, Beginner Friendly")
  reservedSeats Int      @default(45)
  totalSeats    Int      @default(60)
  isFeatured    Boolean  @default(true)
  status        String   @default("active") @db.VarChar(50)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([siteId, isFeatured])
  @@index([siteId, status], map: "CommunityEvent_siteId_status_idx")
  @@index([siteId, status, isFeatured], map: "CommunityEvent_siteId_status_isFeatured_idx")
  @@map("community_events")
}

model ad {
  id           String       @id @default(cuid()) @db.VarChar(50)
  zoneId       String       @db.VarChar(50)
  advertiserId String?      @db.VarChar(50)
  campaignId   String?      @db.VarChar(50)
  name         String       @db.VarChar(191)
  type         String       @db.VarChar(50)
  code         String?      @db.Text
  imageUrl     String?      @db.VarChar(500)
  targetUrl    String?      @db.VarChar(500)
  isActive     Boolean      @default(true)
  status       String       @default("draft") @db.VarChar(20)
  startDate    DateTime?
  endDate      DateTime?
  priority     Int          @default(50)
  targeting    String?      @db.Text
  scheduling   String?      @db.Text
  impressions  Int          @default(0)
  clicks       Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  ctaText      String?      @db.VarChar(100)
  description  String?      @db.Text
  headline     String?      @db.VarChar(255)
  maxClicks    Int?
  ctaColor     String?      @db.VarChar(20)
  zone         adzone       @relation(fields: [zoneId], references: [id])
  advertiser   advertiser?  @relation(fields: [advertiserId], references: [id], onDelete: SetNull)
  campaign     adcampaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  analytics    adanalytic[]

  @@index([advertiserId], map: "Ad_advertiserId_idx")
  @@index([campaignId], map: "Ad_campaignId_idx")
  @@index([zoneId], map: "Ad_zoneId_idx")
}

model adanalytic {
  id        String   @id @default(cuid()) @db.VarChar(50)
  adId      String   @db.VarChar(50)
  type      String   @db.VarChar(50)
  visitorId String?  @db.VarChar(100)
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  createdAt DateTime @default(now())
  ad        ad       @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId], map: "AdAnalytic_adId_idx")
}

model adcampaign {
  id          String    @id @default(cuid()) @db.VarChar(50)
  siteId      String    @db.VarChar(100)
  name        String    @db.VarChar(191)
  description String?   @db.Text
  budget      Float?
  startDate   DateTime?
  endDate     DateTime?
  status      String    @default("active") @db.VarChar(20)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  ads         ad[]

  @@index([siteId], map: "AdCampaign_siteId_idx")
}

model advertiser {
  id          String   @id @default(cuid()) @db.VarChar(50)
  siteId      String   @db.VarChar(100)
  companyName String   @db.VarChar(191)
  contactName String?  @db.VarChar(191)
  email       String?  @db.VarChar(191)
  phone       String?  @db.VarChar(50)
  website     String?  @db.VarChar(255)
  logo        String?  @db.VarChar(500)
  status      String   @default("active") @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ads         ad[]

  @@index([siteId], map: "Advertiser_siteId_idx")
}

model adzone {
  id        String   @id @default(cuid()) @db.VarChar(50)
  siteId    String   @db.VarChar(100)
  name      String   @db.VarChar(191)
  slug      String   @db.VarChar(100)
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ads       ad[]

  @@unique([siteId, slug], map: "AdZone_siteId_slug_key")
  @@index([siteId], map: "AdZone_siteId_idx")
}

model apikey {
  id        String    @id @default(cuid()) @db.VarChar(50)
  siteId    String    @db.VarChar(100)
  name      String    @db.VarChar(191)
  key       String    @unique(map: "ApiKey_key_key") @db.VarChar(191)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([siteId], map: "ApiKey_siteId_idx")
}

model auditlog {
  id        String   @id @default(cuid()) @db.VarChar(50)
  siteId    String?  @db.VarChar(100)
  userId    String?  @db.VarChar(50)
  action    String   @db.VarChar(100)
  meta      Json?
  createdAt DateTime @default(now())
  user      user?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt], map: "AuditLog_createdAt_idx")
  @@index([siteId], map: "AuditLog_siteId_idx")
  @@index([userId], map: "AuditLog_userId_idx")
}

model campaignlog {
  id           String        @id @default(cuid()) @db.VarChar(50)
  campaignId   String        @db.VarChar(50)
  subscriberId String        @db.VarChar(50)
  status       String        @default("pending") @db.VarChar(20)
  errorMessage String?       @db.Text
  sentAt       DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  campaign     emailcampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriber   subscriber    @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([campaignId, subscriberId], map: "CampaignLog_campaignId_subscriberId_key")
  @@index([campaignId], map: "CampaignLog_campaignId_idx")
  @@index([subscriberId], map: "CampaignLog_subscriberId_idx")
}

model category {
  id        String    @id @default(cuid()) @db.VarChar(50)
  siteId    String    @db.VarChar(100)
  name      String    @db.VarChar(100)
  slug      String    @db.VarChar(100)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  posts     post[]    @relation("CategoryToPost")

  @@unique([siteId, name], map: "Category_siteId_name_key")
  @@unique([siteId, slug], map: "Category_siteId_slug_key")
  @@index([siteId], map: "Category_siteId_idx")
}

model comment {
  id          String    @id @default(cuid()) @db.VarChar(50)
  siteId      String    @db.VarChar(100)
  postId      String?   @db.VarChar(50)
  magazineId  Int?
  authorName  String    @db.VarChar(191)
  authorEmail String    @db.VarChar(191)
  content     String    @db.Text
  status      String    @default("pending") @db.VarChar(20)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  post        post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  magazine    Magazine? @relation(fields: [magazineId], references: [id], onDelete: Cascade)

  @@index([postId], map: "Comment_postId_idx")
  @@index([magazineId], map: "Comment_magazineId_idx")
  @@index([siteId], map: "Comment_siteId_idx")
  @@index([siteId, postId, status, createdAt], map: "Comment_siteId_postId_status_createdAt_idx")
}

model contactformsubmission {
  id        String    @id @default(cuid()) @db.VarChar(50)
  siteId    String    @db.VarChar(100)
  name      String    @db.VarChar(191)
  email     String    @db.VarChar(191)
  phone     String?   @db.VarChar(50)
  message   String    @db.Text
  status    String    @default("new") @db.VarChar(20)
  notes     String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([siteId], map: "ContactFormSubmission_siteId_idx")
  @@index([siteId, status], map: "ContactFormSubmission_siteId_status_idx")
}

model contentversion {
  id         String   @id @default(cuid())
  siteId     String   @db.VarChar(100)
  entityType String   @db.VarChar(20)
  entityId   String   @db.VarChar(36)
  version    Int
  data       Json
  createdBy  String?
  createdAt  DateTime @default(now())

  @@index([createdAt], map: "ContentVersion_createdAt_idx")
  @@index([siteId, entityType, entityId], map: "ContentVersion_siteId_entityType_entityId_idx")
  @@index([siteId, entityType, entityId, version], map: "ContentVersion_siteId_entityType_entityId_version_idx")
}

model cookieconsentlog {
  id        String   @id @default(cuid())
  siteId    String   @db.VarChar(100)
  visitorId String   @db.VarChar(100)
  accepted  Boolean  @default(false)
  analytics Boolean  @default(false)
  marketing Boolean  @default(false)
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([siteId], map: "CookieConsentLog_siteId_idx")
  @@index([visitorId], map: "CookieConsentLog_visitorId_idx")
  @@index([siteId, createdAt], map: "CookieConsentLog_siteId_createdAt_idx")
}

model emailcampaign {
  id                String             @id @default(cuid()) @db.VarChar(50)
  siteId            String             @db.VarChar(100)
  name              String             @db.VarChar(191)
  subject           String             @db.VarChar(255)
  body              String             @db.LongText
  listId            String?            @db.VarChar(50)
  status            String             @default("draft") @db.VarChar(20)
  scheduledAt       DateTime?
  sentAt            DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  list              subscriberlist?    @relation(fields: [listId], references: [id], onDelete: SetNull)
  logs              campaignlog[]
  pushNotifications pushnotification[]
  emailLogs         emaillog[]

  @@index([listId], map: "EmailCampaign_listId_fkey")
  @@index([siteId], map: "EmailCampaign_siteId_idx")
}

model emaillog {
  id           String    @id @default(cuid()) @db.VarChar(50)
  siteId       String    @db.VarChar(100)
  category     String    @db.VarChar(50) // "transactional" | "campaign" | "system"
  triggerKey   String?   @db.VarChar(100) // e.g. "password_reset", "otp_verification" — null for campaigns
  campaignId   String?   @db.VarChar(100) // set when category = "campaign", FK to emailcampaign
  templateId   String?   @db.VarChar(100) // emailtemplate.id when a stored template was used
  toEmail      String    @db.VarChar(191)
  toName       String?   @db.VarChar(191)
  fromEmail    String?   @db.VarChar(191)
  subject      String?   @db.Text
  provider     String?   @db.VarChar(50) // "resend" | "sendgrid" | "smtp"
  status       String    @default("queued") @db.VarChar(20) // queued | sending | sent | failed
  errorMessage String?   @db.Text
  bodyPreview  String?   @db.Text // stripped-tag first ~500 chars, not full HTML, to keep rows small
  meta         Json? // { userId, ip, source route, jobId, etc. }
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  campaign emailcampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([siteId, createdAt], map: "EmailLog_siteId_createdAt_idx")
  @@index([siteId, status], map: "EmailLog_siteId_status_idx")
  @@index([toEmail], map: "EmailLog_toEmail_idx")
  @@index([triggerKey], map: "EmailLog_triggerKey_idx")
}

model emailtemplate {
  id          String   @id @default(cuid()) @db.VarChar(50)
  siteId      String   @db.VarChar(100)
  name        String   @db.VarChar(191)
  triggerKey  String?  @db.VarChar(100)
  subject     String?  @db.VarChar(255)
  htmlContent String   @db.LongText
  designJson  String?  @db.LongText
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([siteId], map: "EmailTemplate_siteId_idx")
  @@index([siteId, triggerKey], map: "EmailTemplate_siteId_triggerKey_idx")
}

model faq {
  id           String    @id @default(cuid()) @db.VarChar(50)
  siteId       String    @db.VarChar(100)
  question     String    @db.VarChar(255)
  answer       String    @db.Text
  pageId       String?   @db.VarChar(50)
  sortOrder    Int       @default(0)
  showHide     Boolean   @default(true)
  schemaMarkup Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  page         page?     @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([pageId], map: "Faq_pageId_idx")
  @@index([siteId], map: "Faq_siteId_idx")
  @@index([siteId, sortOrder], map: "Faq_siteId_sortOrder_idx")
}

model frontendproject {
  id               String    @id @default(cuid()) @db.VarChar(50)
  siteId           String    @db.VarChar(100)
  name             String    @db.VarChar(191)
  framework        String    @db.VarChar(50)
  apiKey           String    @unique(map: "FrontendProject_apiKey_key") @db.VarChar(191)
  isActive         Boolean   @default(true)
  lastSyncAt       DateTime?
  baseUrl          String?   @db.VarChar(255)
  sdkVersion       String?   @db.VarChar(50)
  syncStatus       String?   @db.VarChar(50)
  lastManifestHash String?   @db.VarChar(100)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([siteId], map: "FrontendProject_siteId_idx")
  @@index([siteId, isActive], map: "FrontendProject_siteId_isActive_idx")
}

model globalsettings {
  id                String    @id @default(cuid()) @db.VarChar(50)
  siteId            String    @unique(map: "GlobalSettings_siteId_key") @db.VarChar(100)
  header            Json?
  footer            Json?
  analytics         Json?
  scripts           Json?
  contactDetails    Json?
  websiteSettings   Json?
  emailSettings     Json?
  securityControls  Json?
  compliance        Json?
  notifications     Json?
  ctaConfig         Json?
  performanceConfig Json?
  devTools          Json?
  deploymentNotes   Json?
  navigation        Json?
  adSettings        Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  @@index([siteId], map: "GlobalSettings_siteId_idx")
}

model importbatch {
  id           String         @id @default(cuid()) @db.VarChar(50)
  siteId       String         @db.VarChar(100)
  sourceType   String         @db.VarChar(20)
  targetModel  String         @db.VarChar(50)
  fileName     String         @db.VarChar(255)
  status       String         @default("PENDING") @db.VarChar(20)
  totalRows    Int            @default(0)
  successRows  Int            @default(0)
  failedRows   Int            @default(0)
  errorLog     Json?
  createdBy    String?        @db.VarChar(50)
  createdAt    DateTime       @default(now())
  completedAt  DateTime?
  rolledBackAt DateTime?
  records      importrecord[]

  @@index([siteId], map: "ImportBatch_siteId_idx")
  @@index([status], map: "ImportBatch_status_idx")
}

model importrecord {
  id           String      @id @default(cuid()) @db.VarChar(50)
  batchId      String      @db.VarChar(50)
  targetModel  String      @db.VarChar(50)
  recordId     String      @db.VarChar(100)
  action       String      @db.VarChar(20)
  previousData Json?
  createdAt    DateTime    @default(now())
  batch        importbatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId], map: "ImportRecord_batchId_idx")
  @@index([targetModel, recordId], map: "ImportRecord_targetModel_recordId_idx")
}

model integrationmanifest {
  id           String   @id @default(cuid()) @db.VarChar(50)
  siteId       String   @db.VarChar(100)
  source       String?  @db.VarChar(100)
  manifestHash String?  @db.VarChar(100)
  rawJson      Json
  createdAt    DateTime @default(now())

  @@index([createdAt], map: "IntegrationManifest_createdAt_idx")
  @@index([siteId], map: "IntegrationManifest_siteId_idx")
  @@index([siteId, createdAt], map: "IntegrationManifest_siteId_createdAt_idx")
}

model ipblock {
  id        String   @id @default(cuid()) @db.VarChar(50)
  siteId    String   @db.VarChar(100)
  ipAddress String   @db.VarChar(45)
  reason    String?
  createdAt DateTime @default(now())

  @@unique([siteId, ipAddress], map: "IpBlock_siteId_ipAddress_key")
  @@index([siteId], map: "IpBlock_siteId_idx")
}

model lead {
  id              String    @id @default(cuid()) @db.VarChar(50)
  siteId          String    @db.VarChar(100)
  name            String    @db.VarChar(191)
  email           String    @db.VarChar(191)
  phone           String?   @db.VarChar(50)
  serviceInterest String?   @db.VarChar(100)
  sourcePage      String?   @db.VarChar(255)
  status          String    @default("new") @db.VarChar(20)
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
