  email              String          @unique(map: "User_email_key") @db.VarChar(191)
  name               String?         @db.VarChar(191)
  bio                String?         @db.Text
  image              String?         @db.VarChar(500)
  passwordHash       String          @db.VarChar(255)
  legacyPasswordHash String?         @db.VarChar(255)
  socialLinks        Json?
  globalRole         user_globalRole @default(VIEWER)
  isActive           Boolean         @default(true)
  twoFAEnabled       Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?
  posts              post[]
  recipes            recipe[]        @relation("RecipeContributor")
  savedArticles      savedarticle[]
  savedRecipes       savedrecipe[]
  recipeComments     recipecomment[]
  recipeLikes        recipelike[]
  recipeRatings      reciperating[]
  siteUsers          siteuser[]
  loginHistory       loginhistory[]
  auditLogs          auditlog[]

  @@index([email], map: "User_email_idx")
  @@index([isActive], map: "User_isActive_idx")
}

model visitorlog {
  id            String   @id @default(cuid()) @db.VarChar(50)
  siteId        String   @db.VarChar(100)
  visitorId     String   @db.VarChar(100)
  pageViewed    String   @db.VarChar(255)
  ipAddress     String?  @db.VarChar(45)
  location      String?  @db.VarChar(100)
  deviceInfo    String?  @db.VarChar(255)
  trafficSource String?  @db.VarChar(100)
  duration      Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([siteId, createdAt], map: "VisitorLog_siteId_createdAt_idx")
  @@index([siteId], map: "VisitorLog_siteId_idx")
}

model webhookevent {
  id        String   @id @default(cuid()) @db.VarChar(50)
  siteId    String   @db.VarChar(100)
  type      String   @db.VarChar(100)
  payload   Json
  createdAt DateTime @default(now())

  @@index([siteId], map: "WebhookEvent_siteId_idx")
  @@index([type], map: "WebhookEvent_type_idx")
}

model webhooksubscription {
  id        String    @id @default(cuid()) @db.VarChar(50)
  siteId    String    @db.VarChar(100)
  name      String    @db.VarChar(191)
  url       String    @db.VarChar(500)
  events    Json
  secret    String    @db.VarChar(255)
  isActive  Boolean   @default(true)
  failCount Int       @default(0)
  lastError String?   @db.Text
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  userId    String?   @db.VarChar(100)

  @@index([siteId], map: "WebhookSubscription_siteId_idx")
  @@index([siteId, isActive], map: "WebhookSubscription_siteId_isActive_idx")
  @@index([userId], map: "WebhookSubscription_userId_fkey")
}

model componentcontent {
  id           String   @id @default(cuid()) @db.VarChar(50)
  siteId       String   @db.VarChar(50)
  pageSlug     String   @db.VarChar(100)
  componentKey String   @db.VarChar(50)
  data         Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([siteId, pageSlug, componentKey], map: "ComponentContent_siteId_pageSlug_componentKey_key")
  @@index([siteId], map: "ComponentContent_siteId_idx")
}

