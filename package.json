{
  "name": "global-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --dns-result-order=ipv4first node_modules/next/dist/bin/next dev",
    "build": "prisma generate --schema=prisma/schema.prisma && node scripts/generate-routes.js && next build --webpack",
    "start": "node --dns-result-order=ipv4first node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "db:generate": "npx prisma generate --schema=prisma/schema.prisma",
    "db:push": "npx prisma db push --schema=prisma/schema.prisma",
    "db:seed": "node prisma/seed.js",
    "db:migrate": "node scripts/db-migrate.js",
    "db:verify": "node scripts/verify-production-schema.mjs",
    "db:verify-checksums": "node scripts/verify-migration-checksums.mjs",
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "ngrok": "npx ngrok http 3000",
    "search:reindex": "node scripts/reindex-search.js",
    "search:health": "node scripts/check-typesense.js",
    "test": "vitest run"
  },
  "dependencies": {
