# ==============================================================================
# GLOBAL BACKEND CMS & FRONTEND ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to `.env` and replace placeholders with actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MySQL / MariaDB)
# ------------------------------------------------------------------------------
DATABASE_URL="mysql://user:password@localhost:3306/ahp_reimagined"
DATABASE_CONNECTION_LIMIT="10"

# Optional Migration Integration Test Environment (Disposable DB)
# TEST_DATABASE_URL="mysql://user:password@localhost:3306/ahp_disposable_test_db"
# RUN_MIGRATION_INTEGRATION_TESTS="false"

# ------------------------------------------------------------------------------
# 2. SITE & BRANDING IDENTIFIERS
# ------------------------------------------------------------------------------
SITE_ID="AHP"
NEXT_PUBLIC_SITE_ID="AHP"

# ------------------------------------------------------------------------------
# 3. BASE URLS & APP CONFIG
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CMS_BASE_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
ALLOWED_CORS_ORIGINS="http://localhost:3000,https://yourdomain.com"

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY (NextAuth & TOTP)
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET="your-32-character-random-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"
TOTP_ISSUER="GlobalCMS"
CMS_INTEGRATION_KEY="your-cms-integration-revalidation-key"

# ------------------------------------------------------------------------------
# 5. RECAPTCHA SECURITY (Google reCAPTCHA v2/v3)
# ------------------------------------------------------------------------------
RECAPTCHA_SITE_KEY="your-recaptcha-site-key"
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your-recaptcha-site-key"
RECAPTCHA_SECRET_KEY="your-recaptcha-secret-key"

# ------------------------------------------------------------------------------
# 6. MEDIA STORAGE (S3 / Backblaze B2 / MinIO / Cloudinary)
# ------------------------------------------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="ahp-media"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# Media Storage Safety Rules:
# Production:
#   FORCE_S3=true
#   ALLOW_LOCAL_MEDIA_STORAGE=false
#   NOTE: ALLOW_LOCAL_MEDIA_STORAGE must never be enabled in production.
#
# Development (Intentional local development without S3):
#   NODE_ENV=development
#   FORCE_S3=false
#   ALLOW_LOCAL_MEDIA_STORAGE=true
FORCE_S3="true"
ALLOW_LOCAL_MEDIA_STORAGE="false"

# Note: All media uploads (blog library, magazine covers, back & spine images) use S3 storage exclusively.
# CLOUDINARY_* vars are no longer used for upload fallbacks (kept only for legacy read URL compatibility).
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ------------------------------------------------------------------------------
# 7. REDIS & QUEUE WORKERS (Bull Queue & Cache)
# ------------------------------------------------------------------------------
# Local Redis: redis://localhost:6379
# Production TLS: rediss://default:password@your-redis-host:6379
REDIS_URL="redis://localhost:6379"
DISABLE_BULL_WORKERS="false"

# ------------------------------------------------------------------------------
# 8. TYPESENSE SEARCH ENGINE
# ------------------------------------------------------------------------------
TYPESENSE_HOST="localhost"
TYPESENSE_PORT="8108"
TYPESENSE_PROTOCOL="http"
TYPESENSE_ADMIN_API_KEY="your-typesense-admin-api-key"
TYPESENSE_COLLECTION_ALIAS="content"

# ------------------------------------------------------------------------------
# 9. EMAIL & SMTP CONFIGURATION
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="user@example.com"
SMTP_PASS="your-smtp-password"
FORM_EMAIL="contact@example.com"

# ------------------------------------------------------------------------------
# 10. NOTIFICATIONS & INTEGRATIONS (Novu)
# ------------------------------------------------------------------------------
NOVU_API_KEY="your-novu-api-key"
NOVU_WORKFLOW_ID="your-novu-workflow-id"
NOVU_ENABLE_CAMPAIGN_TRIGGER="false"

# ------------------------------------------------------------------------------
# 11. STRIPE PAYMENTS (Optional)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# ------------------------------------------------------------------------------
# 12. OBSERVABILITY & MONITORING (Sentry & Grafana Loki)
# ------------------------------------------------------------------------------
# Sentry Runtime DSN & Config
NEXT_PUBLIC_SENTRY_DSN="https://your-dsn@o0.ingest.sentry.io/0"
SENTRY_DSN="https://your-dsn@o0.ingest.sentry.io/0"
SENTRY_ENVIRONMENT="development"
SENTRY_RELEASE="1.0.0"
SENTRY_AUTH_TOKEN="sntrys_your_sentry_auth_token"
SENTRY_ORG="your-org-slug"
SENTRY_PROJECT="your-project-slug"
SENTRY_PROJECT_URL="https://your-org.sentry.io/issues/"

# Grafana Loki & Monitoring Dashboards
GRAFANA_LOKI_HOST="https://logs-prod-028.grafana.net"
GRAFANA_LOKI_URL="https://logs-prod-028.grafana.net"
GRAFANA_LOKI_USER="123456"
GRAFANA_LOKI_API_KEY="glc_your_grafana_loki_api_key"
GRAFANA_LOKI_ENDPOINT="/loki/api/v1/push"
GRAFANA_DASHBOARD_URL="https://your-stack.grafana.net/d/dashboard-id"
GRAFANA_SYNTHETIC_CHECK_URL="https://your-stack.grafana.net/a/grafana-synthetic-monitoring-app/checks"
OBSERVABILITY_TEST_ENABLED="false"

# ------------------------------------------------------------------------------
# 13. CRON JOBS & SCHEDULED TASKS (Vercel Cron / GitHub Actions / External Schedulers)
# ------------------------------------------------------------------------------
# Secret token required to authenticate external cron triggers:
# Supported headers/query:
#   - Header: Authorization: Bearer <CRON_SECRET>
#   - Header: x-cron-secret: <CRON_SECRET>
#   - Query:  ?secret=<CRON_SECRET>
CRON_SECRET="your-random-32-character-cron-secret-key"